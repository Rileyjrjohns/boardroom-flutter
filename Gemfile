# Ruby tools of the delivery setup (see "Delivery" in README.md and docs/ci-cd.md). Install them with
# Bundler from the root of the repository, never as global gems:
#
#   bundle config set --local path vendor/bundle
#   bundle install
#   cd ios && bundle exec fastlane ios build        # the Gemfile is found in the parent folder
#
# Fastlane is pinned to one exact version, so that a release is built with the tool that was tested.
source 'https://rubygems.org'

gem 'fastlane', '2.240.1'
