<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!--
    Both are normal permissions, granted at install time, and the manifest merger adds them to the
    app. The first lets the plugin know that a screenshot of the app was taken (Android 14 and
    later), the second that the screen is being recorded (Android 15 and later). Without them the
    calls throw a SecurityException, which the plugin catches: the detection is simply off.
  -->
  <uses-permission android:name="android.permission.DETECT_SCREEN_CAPTURE" />
  <uses-permission android:name="android.permission.DETECT_SCREEN_RECORDING" />
</manifest>
