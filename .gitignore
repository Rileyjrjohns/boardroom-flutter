# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/packages/*/build/
/coverage/

# Native build outputs. Gradle is redirected to /build/ by android/build.gradle.kts, so these are for
# a build started from Android Studio or Xcode with another configuration; the pods are rebuilt by
# `pod install` from ios/Podfile.lock, which is committed.
/android/build/
/android/app/build/
/android/.cxx/
/ios/build/
/ios/Pods/
/ios/.symlinks/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Coverage
*.lcov

# Written by tool/coverage_helper.dart before the coverage run (see README)
/test/coverage_helper_test.dart

# gen-l10n output, rebuilt by `flutter pub get` and `flutter gen-l10n` (see README)
/lib/l10n/app_localizations*.dart

# Generated by build_runner (freezed, json_serializable and drift), rebuilt by `dart run build_runner build` (see README)
*.g.dart
*.freezed.dart
*.drift.dart

# Native signing material
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# Environment files
.env
.env.*
!.env.example

# The generated Dart of the screen protection plugin is the exception to the rule above: the native builds need it, so it is committed and CI checks that regenerating it changes nothing (packages/screen_protection/README.md)
!/packages/screen_protection/lib/src/messages.g.dart

# Golden tests: only the CI goldens (text drawn as blocks, the same on every operating system) are fixtures; the platform ones (real text, one folder per operating system) are for reading by eye and depend on the machine (README, "Golden tests")
/test/golden/goldens/*
!/test/golden/goldens/ci/
/test/golden/failures/

# Written by patrol_cli when it runs the tests (the entrypoint that lists them): not a source file.
/integration_test/test_bundle.dart

# Delivery (README, "Delivery"): the Bundler install, the Android signing files that the CI lane writes, the Fastlane reports
/.bundle/
/vendor/bundle/
/android/key.properties
/android/app/upload-keystore.jks
/ios/fastlane/report.xml
/android/fastlane/report.xml
/ios/fastlane/README.md
/android/fastlane/README.md
