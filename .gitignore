#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Coverage
*.lcov

# Written by tool/coverage_helper.dart before the coverage run (see README)
/test/coverage_helper_test.dart

# gen-l10n output, rebuilt by `flutter pub get` and `flutter gen-l10n` (see README)
/lib/l10n/app_localizations*.dart

# Generated by build_runner (later steps), rebuilt by `dart run build_runner build` (see README)
*.g.dart
*.freezed.dart

# Native signing material
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# Environment files
.env
.env.*
!.env.example
